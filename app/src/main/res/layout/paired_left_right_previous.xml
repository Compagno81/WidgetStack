<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@id/widget_area" android:layout_width="match_parent" android:layout_height="match_parent">
        <ViewFlipper android:id="@id/transition" android:layout_width="match_parent" android:layout_height="match_parent"
            android:inAnimation="@anim/from_left" android:animateFirstView="true">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"/>
            <FrameLayout android:id="@id/content" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </ViewFlipper>
    </FrameLayout>
    <include layout="@layout/paired_left_right_controls"/>
</FrameLayout>
