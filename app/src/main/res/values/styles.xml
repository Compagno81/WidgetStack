<resources>
 <color name="app_primary">#4F5F91</color>
 <color name="app_surface">#F6F6FA</color>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">@color/app_primary</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:statusBarColor">@color/app_surface</item>
  <item name="android:navigationBarColor">@color/app_surface</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowBackground">@color/app_surface</item>
  <item name="android:windowNoTitle">true</item>
 </style>
</resources>
